{
  "name": "Miniature Worlds — 3D Custom Diorama Studio",
  "version": "1.0.0",
  "description": "An independent artisan storefront for custom scale dioramas. Its agents design a procedural 3D blueprint from a brief, quote it under scale rules, negotiate within a 12% discount, and manage the commission board. Other agentic sites can request quotes and confirm commissions over window.postMessage.",
  "profile": "worldwide-agentic-web-mvp-0.2",
  "endpoint": "https://isgudtek.github.io/open-agentic-dioramas/diorama-studio/",
  "networks": [
    {
      "name": "diorama_studio",
      "description": "Design, quote, negotiate and fabricate custom dioramas.",
      "front_man": "diorama_designer",
      "hocon": "diorama_studio.network.json"
    }
  ],
  "default_network": "diorama_studio",
  "capabilities": [
    "diorama.design",
    "diorama.quote",
    "diorama.negotiate",
    "diorama.commission",
    "3d.preview"
  ],
  "catalog": {
    "scales": [
      "1:12",
      "1:35",
      "1:64",
      "1:72"
    ],
    "scale_rules": {
      "1:12": {
        "min_cm": 20,
        "max_cm": 60
      },
      "1:35": {
        "min_cm": 20,
        "max_cm": 120
      },
      "1:64": {
        "min_cm": 15,
        "max_cm": 100
      },
      "1:72": {
        "min_cm": 15,
        "max_cm": 100
      }
    },
    "terrains": [
      "desert",
      "urban",
      "forest",
      "snow"
    ],
    "features": [
      "resin water",
      "LED lighting",
      "weathering"
    ],
    "currency": "USD",
    "max_discount_pct": 12
  },
  "agents": [
    {
      "name": "diorama_designer",
      "role": "Brief or RFQ -> 3D scene graph (terrain, water, LEDs, structures)"
    },
    {
      "name": "diorama_estimator",
      "role": "Materials + labour pricing, scale rules, counter-offers within a 12% floor"
    },
    {
      "name": "workshop_operator",
      "role": "Live Three.js preview and commission board operations (rule-based)"
    }
  ],
  "tools": [
    {
      "name": "request_quote",
      "effect": "preview",
      "requires_approval": false,
      "rpc_callable": true,
      "description": "Design + price a diorama for an RFQ and render the 3D preview. Logging the RFQ on the board is a separate approved write.",
      "input_schema": {
        "type": "object",
        "required": [
          "rfq"
        ],
        "properties": {
          "rfq": {
            "type": "object"
          },
          "caller_agent": {
            "type": "string"
          }
        }
      }
    },
    {
      "name": "negotiate_quote",
      "effect": "preview",
      "requires_approval": false,
      "rpc_callable": true,
      "description": "Non-binding counter-offer on an open quote. Max 3 rounds; never below the studio's floor.",
      "input_schema": {
        "type": "object",
        "required": [
          "quote_id",
          "counter_price"
        ],
        "properties": {
          "quote_id": {
            "type": "string"
          },
          "counter_price": {
            "type": "number"
          },
          "message": {
            "type": "string"
          }
        }
      }
    },
    {
      "name": "render_diorama_preview",
      "effect": "preview",
      "requires_approval": false,
      "rpc_callable": true,
      "description": "Render a scene graph in the live Three.js viewport. Nothing is stored.",
      "input_schema": {
        "type": "object",
        "required": [
          "scene"
        ],
        "properties": {
          "scene": {
            "type": "object"
          }
        }
      }
    },
    {
      "name": "get_board",
      "effect": "read",
      "requires_approval": false,
      "rpc_callable": true,
      "description": "Read the commission board.",
      "input_schema": {
        "type": "object",
        "properties": {}
      }
    },
    {
      "name": "log_rfq",
      "effect": "write",
      "requires_approval": true,
      "rpc_callable": false,
      "description": "Add an RFQ card to Incoming RFQ.",
      "input_schema": {
        "type": "object",
        "required": [
          "quote_id"
        ],
        "properties": {
          "quote_id": {
            "type": "string"
          }
        }
      }
    },
    {
      "name": "confirm_commission",
      "effect": "write",
      "requires_approval": true,
      "rpc_callable": true,
      "description": "Lock a build slot for an agreed quote and move it to 3D Blueprint Approved. The price must equal the agreed price.",
      "input_schema": {
        "type": "object",
        "required": [
          "quote_id",
          "price"
        ],
        "properties": {
          "quote_id": {
            "type": "string"
          },
          "price": {
            "type": "number"
          },
          "buyer_ref": {
            "type": "string"
          }
        }
      }
    },
    {
      "name": "start_fabrication",
      "effect": "write",
      "requires_approval": true,
      "rpc_callable": false,
      "description": "Move a confirmed order to In Fabrication.",
      "input_schema": {
        "type": "object",
        "required": [
          "order_id"
        ],
        "properties": {
          "order_id": {
            "type": "string"
          }
        }
      }
    }
  ],
  "rpc": {
    "transport": "window.postMessage",
    "request": "OAW_RPC_REQUEST",
    "response": "OAW_RPC_RESPONSE",
    "event": "OAW_RPC_EVENT",
    "methods": [
      "ping",
      "manifest",
      "getState",
      "run",
      "callTool"
    ],
    "trusted_origins": [
      "https://isgudtek.github.io"
    ],
    "consent": "Origins not listed in trusted_origins are asked for once. Every write tool still pauses for approval on this site."
  },
  "window_api": "window.OpenAgenticWeb",
  "llm": {
    "providers": [
      {
        "id": "otari",
        "label": "Mozilla Otari Gateway (BYOK)",
        "base_url": "https://api.otari.ai/api/v1",
        "eu_base_url": "https://eu.api.otari.ai/api/v1",
        "model_format": "provider:model"
      },
      {
        "id": "nano",
        "label": "Gemini Nano (Chrome Prompt API)",
        "fallback": "Gemini Nano (Local Sim), labeled simulated"
      },
      {
        "id": "hybrid",
        "label": "Hybrid Auto: Nano local, Otari cloud fallback"
      },
      {
        "id": "demo",
        "label": "Demo Mode (deterministic, no key)"
      }
    ],
    "note": "Visitors choose the provider. Keys stay in the visitor's browser on this origin."
  },
  "peer_policy": {
    "mode": "open",
    "inbound": "postMessage RPC with origin checks",
    "outbound": "none"
  }
}
