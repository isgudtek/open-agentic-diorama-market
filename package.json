{
  "name": "open-agentic-diorama-market",
  "version": "2.0.0",
  "private": true,
  "description": "Three interconnected open agentic websites (a procurement hub and two competing 3D diorama studios) with Mozilla Otari, Gemini Nano and Demo Mode. Zero backend, zero dependencies.",
  "type": "module",
  "license": "MIT",
  "engines": { "node": ">=18" },
  "scripts": {
    "start": "node dev-server.js",
    "verify": "node scripts/verify.mjs",
    "build": "node scripts/build-sites.mjs",
    "build:pages": "node scripts/build-sites.mjs --base https://isgudtek.github.io/open-agentic-diorama-market/ --out docs",
    "verify:pages": "node scripts/verify.mjs https://isgudtek.github.io/open-agentic-diorama-market/buyer-hub/ https://isgudtek.github.io/open-agentic-diorama-market/diorama-studio/ https://isgudtek.github.io/open-agentic-diorama-market/frostbite-studio/",
    "legacy:taskhub": "npx serve public"
  }
}
